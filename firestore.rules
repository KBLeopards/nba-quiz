rules_version = '2';
service cloud.firestore {
match /databases/{db}/documents {
function P(c, id) { return /databases/$(db)/documents/$(c)/$(id); }
function A() { return request.auth != null; }
function U() { return request.auth.uid; }
function N() { return request.resource.data; }
function admin() { return A() && request.auth.token.email_verified == true && request.auth.token.email in ['kyubum1231@gmail.com']; }
function me() { return get(P('users', U())).data; }
function ok() { return A() && exists(P('users', U())) && me().status == 'ok'; }
match /users/{uid} {
allow read: if admin() || (A() && U() == uid);
allow create: if A() && U() == uid && N().keys().hasOnly(['name','phone','type','league','nick','invNick','email','status','points','createdAt']) && N().status == 'wait' && N().points == 0 && N().createdAt == request.time && N().type in ['리그원','지인'] && N().nick.size() > 0 && N().nick.size() <= 20 && N().name.size() <= 20 && N().phone.matches('^01[0-9]-[0-9]{3,4}-[0-9]{4}$') && getAfter(P('phones', N().phone)).data.uid == uid;
allow update: if admin() || (ok() && U() == uid && N().diff(resource.data).affectedKeys().hasOnly(['points','lastEx']) && N().points >= 0 && !exists(P('exchanges', N().lastEx)) && getAfter(P('exchanges', N().lastEx)).data.uid == uid && getAfter(P('exchanges', N().lastEx)).data.pts == resource.data.points - N().points);
allow delete: if admin();
}
match /phones/{p} {
allow read, delete: if admin();
allow create: if A() && N().uid == U() && N().keys().hasOnly(['uid']);
}
match /profiles/{uid} { allow read: if A(); allow write: if admin(); }
match /rosters/{id} { allow read, write: if admin(); }
match /quizzes/{d} { allow read: if true; allow write: if admin(); }
match /answers/{aid} {
function w() { return ok() && N().uid == U() && aid == N().date + '_' + U() && request.time < get(P('quizzes', N().date)).data.deadline && N().keys().hasOnly(['uid','date','a','sub']); }
allow read: if admin() || (A() && aid.split('_')[1] == U());
allow create: if admin() || w();
allow update: if admin() || (w() && resource.data.uid == U());
allow delete: if admin();
}
match /chats/{room}/msgs/{mid} {
function c() { return admin() || (ok() && room.split('_')[1] in get(P('answers', room.split('_')[0] + '_' + U())).data.sub); }
allow read: if c();
allow create: if c() && N().uid == U() && N().m.size() > 0 && N().m.size() <= 200 && N().at == request.time && (admin() || N().nick == me().nick);
allow delete: if admin();
}
match /exchanges/{code} {
allow read: if admin() || (A() && resource.data.uid == U());
allow create: if ok() && N().uid == U() && N().code == code && N().status == 'wait' && N().at == request.time && ((N().tier == 'b' && N().pts == 2000 && N().won == 2000) || (N().tier == 's' && N().pts == 5000 && N().won == 5000)) && request.time > me().createdAt + duration.value(14, 'd') && getAfter(P('users', U())).data.points == me().points - N().pts && getAfter(P('users', U())).data.lastEx == code;
allow update, delete: if admin();
}
match /ledger/{id} {
allow read: if admin() || (A() && resource.data.uid == U());
allow write: if admin();
}
}
}
